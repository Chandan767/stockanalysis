# Application Configuration
APP_NAME="Stock AI Platform"
ENVIRONMENT="development"
LOG_LEVEL="INFO"
DEBUG=True

# Database Configuration
DATABASE_URL="postgresql://postgres:postgrespassword@localhost:5432/stock_db"

# Redis Cache Configuration
REDIS_URL="redis://localhost:6379/0"

# Data Providers & API Credentials (Optional / Extensible)
ALPHA_VANTAGE_API_KEY=""
FINNHUB_API_KEY=""
NEWS_API_KEY=""

# AI Engine Key (OpenAI / Gemini / Anthropic)
OPENAI_API_KEY=""
GEMINI_API_KEY=""

# Scoring Weights (Today's Market Research)
WEIGHT_TODAY_TECHNICAL=0.30
WEIGHT_TODAY_MOMENTUM=0.20
WEIGHT_TODAY_VOLUME=0.15
WEIGHT_TODAY_MARKET_TREND=0.15
WEIGHT_TODAY_SECTOR=0.10
WEIGHT_TODAY_NEWS=0.10

# Scoring Weights (Long-Term Stock Research)
WEIGHT_LT_FUNDAMENTAL=0.25
WEIGHT_LT_GROWTH=0.20
WEIGHT_LT_PROFITABILITY=0.15
WEIGHT_LT_BALANCE_SHEET=0.15
WEIGHT_LT_CASH_FLOW=0.10
WEIGHT_LT_VALUATION=0.10
WEIGHT_LT_MANAGEMENT=0.05
